diff --git a/platform/linuxbsd/SCsub b/platform/linuxbsd/SCsub
index abc1234..def5678 100644
--- a/platform/linuxbsd/SCsub
+++ b/platform/linuxbsd/SCsub
@@ -26,6 +26,10 @@ if env["x11"]:
 if env["wayland"]:
     common_linuxbsd += SConscript("wayland/SCsub")

+# Embedded rendering surfaces (for library builds)
+if env["library_type"] in ["static_library", "shared_library"]:
+    common_linuxbsd += SConscript("embedded/SCsub")
+
 if env["speechd"]:
     common_linuxbsd.append("tts_linux.cpp")
     if env["use_sowrap"]:
diff --git a/platform/linuxbsd/api/api.cpp b/platform/linuxbsd/api/api.cpp
