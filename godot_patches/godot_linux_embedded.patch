+#if defined(GLES3_ENABLED)
+#include "platform/linuxbsd/embedded/rendering_native_surface_linux_egl.h"
+#endif
+
+#if defined(VULKAN_ENABLED)
+#include "platform/linuxbsd/embedded/rendering_native_surface_linux_vulkan.h"
+#endif
+
 #endif

 void register_core_linuxbsd_api() {
@@ -20,6 +28,14 @@ void register_core_linuxbsd_api() {
