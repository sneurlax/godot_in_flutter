 	GDREGISTER_ABSTRACT_CLASS(RenderingNativeSurfaceX11);
 #endif
+
+#if defined(GLES3_ENABLED)
+	GDREGISTER_ABSTRACT_CLASS(RenderingNativeSurfaceLinuxEGL);
+#endif
+
+#if defined(VULKAN_ENABLED)
+	GDREGISTER_ABSTRACT_CLASS(RenderingNativeSurfaceLinuxVulkan);
+#endif
 #endif
 }

