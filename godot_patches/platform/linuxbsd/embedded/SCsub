#!/usr/bin/env python

Import("env")

# Files for the Linux embedded rendering surface.
# These provide offscreen rendering capabilities for embedding Godot
# inside other applications (e.g., Flutter, Qt, Electron) on Linux.

source_files = []

# EGL-based offscreen surface (OpenGL path).
if env["opengl3"]:
    source_files.append("rendering_native_surface_linux_egl.cpp")

# Vulkan-based offscreen surface.
if env["vulkan"]:
    source_files.append("rendering_native_surface_linux_vulkan.cpp")
    source_files.append("rendering_context_driver_vulkan_linux_headless.cpp")

objects = []

for source_file in source_files:
    objects.append(env.Object(source_file))

Return("objects")
